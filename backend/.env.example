# Copy this file to backend/.env (never commit backend/.env).
# Everything below is a placeholder. Do not put real secrets in this example file.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database ---
# Local SQLite file, created automatically in the backend folder.
DATABASE_URL=sqlite:///./returnwise.db
# Later, for PostgreSQL: postgresql+psycopg://USER:PASSWORD@localhost:5432/returnwise

# --- Auth ---
# Generate a long random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=60

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# --- AI (Phase 4, optional) ---
# Free-tier Gemini API key only. Leave empty to use the rule-based fallback.
# Never enable billing for this key.
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=10

# --- PayPal (Phase 5, optional) ---
# SANDBOX credentials only. Never use Live credentials or a real account.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com